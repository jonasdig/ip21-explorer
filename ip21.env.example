# IP21 Explorer server configuration.
# Copy to ip21.env next to where you start the server (picked up automatically),
# or pass explicitly with: ip21-explorer --config myfile.env
# Real environment variables override values in this file.

# Data source: sim (built-in simulator) or aspen (live IP21 via tagreader)
IP21_SOURCE=aspen

# Aspen ProcessData REST endpoint and IP21 datasource name.
# List available datasources with: ip21-explorer --list-sources
IP21_ASPEN_URL=https://<server>/ProcessData/AtProcessDataREST.dll
IP21_ASPEN_DATASOURCE=<your IP21 datasource name>

# Set to 0 if a corporate proxy breaks TLS verification.
IP21_VERIFY_SSL=1

# Timezone the IP21 server reports timestamps in.
IP21_TZ=Europe/Oslo

# Where to bind the web server.
IP21_HOST=127.0.0.1
IP21_PORT=8021

# Where saved plot configurations are stored.
#IP21_PLOTS_DIR=plots

# Tag search matches names and descriptions. Names are matched by the server in
# one request, and they decide which tags are looked at; descriptions cost one
# request per tag, so they are only checked when a query pairs part of a tag
# name with another word ("TIC-24 temperature"), and only for this many of the
# name matches. Descriptions stay cached, and the dropdown says when the cap
# was reached. Set to 0 to switch description matching off entirely.
#IP21_DESC_SCAN_MAX=100

# How many tags of one trend request are read from IP21 at once. tagreader
# reads them one after another by default, so a formula over five tags waits
# for five round trips in a row; these run side by side instead. Lower it if
# the IP21 server objects to parallel requests - 1 gives the old behaviour.
#IP21_READ_WORKERS=4

# Most rows IP21 returns for one aggregate (Average/Minimum/Maximum) read; it
# cuts the rest off silently. Longer reads - a month of 1-minute averages for
# total(), say - are split into windows of this many rows. If the server log
# warns that a read came back full, the server's limit is lower: set it here.
#IP21_AGG_MAX_ROWS=10000

# Record maps listed first in each tag's map dropdown, in this order. Real tags
# carry 30+ maps but only a few are used, and duplicating a tag walks this list
# before the rest. Names must match exactly. The star button in a tag's settings
# rewrites this line.
#IP21_FAVORITE_MAPS=CA_I PV,CA_I SP,CA_I OUTPUT
